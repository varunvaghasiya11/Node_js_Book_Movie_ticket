<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
</head>

<body>
    <%- include('../partials/header') %>
        <div class="container py-5 d-flex justify-content-center">
            <div class="col-md-8 col-lg-6">
                <h2 class="text-center mb-5 fw-bold"><span class="text-primary">Add</span> Show</h2>
                <form action="/addshow" method="post" class="p-4 border border-secondary rounded bg-black shadow">

                    <div class="mb-3">
                        <label for="movieId" class="form-label text-secondary">Select Movie</label>
                        <select class="form-select bg-dark text-white border-secondary" id="movieId" name="movieId"
                            required>
                            <option value="" selected disabled>Choose a movie...</option>
                            <% movies.forEach(movie=> { %>
                                <option value="<%= movie._id %>">
                                    <%= movie.title %>
                                </option>
                                <% }); %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="screenId" class="form-label text-secondary">Select Screen</label>
                        <select class="form-select bg-dark text-white border-secondary" id="screenId" name="screenId"
                            required>
                            <option value="" selected disabled>Choose a screen...</option>
                            <% screens.forEach(screen=> { %>
                                <option value="<%= screen._id %>">
                                    <%= screen.theaterId ? screen.theaterId.name : 'Unknown Theater' %> - <%=
                                            screen.screenName %> (<%= screen.screenType %>)
                                </option>
                                <% }); %>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="showDate" class="form-label text-secondary">Date</label>
                            <input type="date" class="form-control" id="showDate" name="showDate" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="showTime" class="form-label text-secondary">Time</label>
                            <input type="time" class="form-control" id="showTime" name="showTime" required>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Add Show</button>
                        <a href="/admin" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../partials/footer') %>
</body>

</html>