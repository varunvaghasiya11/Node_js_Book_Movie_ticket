<%- include('../partials/header') %>

    <div class="container-fluid">
        <div class="row">

            <nav id="sidebarMenu"
                class="col-md-3 col-lg-2 d-md-block bg-black sidebar collapse border-end border-secondary"
                style="min-height: calc(100vh - 80px);">
                <div class="position-sticky pt-4">
                    <h6
                        class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-3 text-primary text-uppercase">
                        <span>Admin Panel</span>
                    </h6>
                    <ul class="nav flex-column gap-2 mb-4">
                        <li class="nav-item">
                            <a class="nav-link active bg-primary text-white rounded mx-2" aria-current="page"
                                href="/admin">
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary mx-2" href="/addmovie">
                                Add Movie
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary mx-2" href="/addtheater">
                                Add Theater
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary mx-2" href="/addscreen">
                                Add Screen
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary mx-2" href="/addshow">
                                Add Show
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>


            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">


                <div class="p-4 mb-4 bg-dark border border-secondary rounded-3 text-light">
                    <div class="container-fluid py-2">
                        <h1 class="display-6 fw-bold">Admin Dashboard</h1>
                        <p class="col-md-8 fs-5 text-secondary">Manage movies, theaters, and bookings.</p>
                    </div>
                </div>

                <div
                    class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom border-secondary">
                    <h1 class="h2 text-white">All Movies</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <a href="/addmovie" class="btn btn-sm btn-outline-primary">Add Movie</a>
                            <a href="/addtheater" class="btn btn-sm btn-outline-primary">Add Theater</a>
                            <a href="/addscreen" class="btn btn-sm btn-outline-primary">Add Screen</a>
                            <a href="/addshow" class="btn btn-sm btn-outline-primary">Add Show</a>
                        </div>
                    </div>
                </div>


                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                    <% movies.forEach(movie=> { %>
                        <div class="col">
                            <div
                                class="card bg-black text-light border-secondary movie-card h-100 position-relative rounded-5">
                                <a href="/admin_movie/<%= movie._id %>"
                                    class="text-decoration-none text-light h-100 d-flex flex-column">
                                    <div class="overflow-hidden movie-img-size">
                                        <img src="<%= movie.image %>" class="card-img-top movie-img"
                                            alt="<%= movie.title %>">
                                    </div>
                                    <div class="card-body">
                                        <h6 class="card-title fw-bold mb-1 text-truncate" title="<%= movie.title %>">
                                            <%= movie.title %>
                                        </h6>
                                        <p class="card-text text-secondary small text-white">
                                            <%= movie.genre %>
                                        </p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <% }); %>
                </div>

                <div
                    class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-5 pb-2 mb-3 border-bottom border-secondary">
                    <h1 class="h2 text-white">All Theaters</h1>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-striped table-hover rounded overflow-hidden">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Location</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof theaters !=='undefined' && theaters.length> 0) { %>
                                <% theaters.forEach(theater=> { %>
                                    <tr>
                                        <td>
                                            <%= theater.name %>
                                        </td>
                                        <td>
                                            <%= theater.location %>
                                        </td>
                                        <td class="text-end">
                                            <a href="/edittheater/<%= theater._id %>"
                                                class="btn btn-sm btn-outline-primary me-2">Edit</a>
                                            <a href="/deletetheater/<%= theater._id %>"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this theater?')">Delete</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="text-center text-muted">No theaters found.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
                <div
                    class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-5 pb-2 mb-3 border-bottom border-secondary">
                    <h1 class="h2 text-white">All Screens</h1>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-striped table-hover rounded overflow-hidden">
                        <thead>
                            <tr>
                                <th scope="col">Screen Name</th>
                                <th scope="col">Theater</th>
                                <th scope="col">Capacity</th>
                                <th scope="col">Type</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof screens !=='undefined' && screens.length> 0) { %>
                                <% screens.forEach(screen=> { %>
                                    <tr>
                                        <td>
                                            <%= screen.screenName %>
                                        </td>
                                        <td>
                                            <%= screen.theaterId ? screen.theaterId.name : 'Unknown' %> - <%=
                                                    screen.theaterId ? screen.theaterId.location : '' %>
                                        </td>
                                        <td>
                                            <%= screen.capacity %>
                                        </td>
                                        <td><span class="badge bg-secondary">
                                                <%= screen.screenType %>
                                            </span></td>
                                        <td class="text-end">
                                            <a href="/editscreen/<%= screen._id %>"
                                                class="btn btn-sm btn-outline-primary me-2">Edit</a>
                                            <a href="/deletescreen/<%= screen._id %>"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this screen?')">Delete</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5" class="text-center text-muted">No screens found.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>

                <div
                    class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-5 pb-2 mb-3 border-bottom border-secondary">
                    <h1 class="h2 text-white">All Shows</h1>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-striped table-hover rounded overflow-hidden">
                        <thead>
                            <tr>
                                <th scope="col">Movie</th>
                                <th scope="col">Theater - Screen</th>
                                <th scope="col">Date & Time</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof shows !=='undefined' && shows.length> 0) { %>
                                <% shows.forEach(show=> { %>
                                    <tr>
                                        <td>
                                            <%= show.movieId ? show.movieId.title : 'Deleted Movie' %>
                                        </td>
                                        <td>
                                            <% if (show.screenId && show.screenId.theaterId) { %>
                                                <%= show.screenId.theaterId.name %> - <%= show.screenId.screenName %>
                                                        <% } else { %>
                                                            Unknown Location
                                                            <% } %>
                                        </td>
                                        <td>
                                            <%= new Date(show.showDate).toLocaleDateString() %> at <%= show.showTime %>
                                        </td>
                                        <td class="text-end">
                                            <a href="/editshow/<%= show._id %>"
                                                class="btn btn-sm btn-outline-primary me-2">Edit</a>
                                            <a href="/deleteshow/<%= show._id %>" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this show?')">Delete</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center text-muted">No shows found.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
        </div>

        </main>
    </div>
    </div>

    <%- include('../partials/footer') %>