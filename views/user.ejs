<%- include('../partials/header') %>


    <section class="hero-section text-center py-5 mb-5"
        style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://image.tmdb.org/t/p/original/9gk7adHYeDvHkCSEqAvQNLV5Uge.jpg') center/cover no-repeat;">
        <div class="container py-5">
            <h1 class="display-3 fw-bold mb-3 text-white">Experience the Magic of Cinema</h1>
            <p class="lead text-light mb-4 text-opacity-75">Book tickets for the latest blockbusters in just a few
                clicks.</p>
            <a href="#movies" class="btn btn-primary btn-lg rounded-pill px-5">Browse Movies</a>
        </div>
    </section>


    <section id="movies" class="container mb-5">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h2 class="text-center fw-bold"><span class="text-primary">Now</span> Showing</h2>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            <% movies.forEach(movie=> { %>
                <div class="col">
                    <div class="card bg-dark text-light border-secondary movie-card h-100 rounded-5">
                        <a href="/movie/<%= movie._id %>" class="text-decoration-none text-light">
                            <div class="movie-img-size">
                                <img src="<%= movie.image %>" class="card-img-top movie-img" alt="<%= movie.title %>">
                            </div>
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title fw-bold mb-0 text-truncate">
                                        <%= movie.title %>
                                    </h5>
                                    <span class="badge bg-warning text-dark">IMDb <%= movie.rating %></span>
                                </div>
                                <div class="mb-2">
                                    <span class="badge bg-secondary text-light">
                                        <%= movie.runtime_h %>h <%= movie.runtime_m %>m
                                    </span>
                                </div>
                                <p class="card-text text-secondary small flex-grow-1">
                                    <%= movie.description.substring(0, 100) %>...
                                </p>
                                <div class="d-grid mt-3">
                                    <a href="/movie/<%= movie._id %>" class="btn btn-outline-primary">Book Now</a>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <% }); %>
        </div>
    </section>

    <%- include('../partials/footer') %>