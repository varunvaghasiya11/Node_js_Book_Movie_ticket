<%- include('../partials/header', { title: 'Forget Password' }) %>

    <div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="card bg-dark border-secondary p-4 shadow-lg" style="width: 100%; max-width: 400px;">
            <h2 class="text-center fw-bold mb-4">Forget Password</h2>

            <% if (typeof error !=='undefined' && error) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/forget-password" method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label text-secondary">Email address</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <div class="mb-4">
                            <label for="password" class="form-label text-secondary">Change Password</label>
                            <input type="password" class="form-control" id="password" name="password" required>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
        </div>
    </div>

    <%- include('../partials/footer') %>